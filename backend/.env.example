# Copy to .env and fill in. Never commit .env (it is git-ignored).

# Server
NODE_ENV=development
PORT=5000
# Frontend origins allowed by CORS. CLIENT_URL (single) still works;
# CLIENT_URLS takes a comma-separated list for both public sites.
CLIENT_URL=http://localhost:5173
CLIENT_URLS=https://stevenkayelu.online,https://www.stevenkayelu.online,https://devegenventures.com,https://www.devegenventures.com
# Number of reverse proxies in front of the API (Render = 1). Defaults to 1
# in production. Needed so rate limits apply per visitor, not globally.
# TRUST_PROXY=1

# Database
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# JWT: use long random values, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-me
JWT_REFRESH_EXPIRES_IN=30d

# Salt for hashing enquiry IP addresses (abuse tracing without storing IPs)
LEAD_IP_SALT=replace-me

# Admin site URL used in notification emails
ADMIN_URL=https://stevenkayelu.online
# Set to "none" if the admin and API are on different sites (requires HTTPS)
# COOKIE_SAMESITE=lax

# Email for lead notifications (staff only). Leave empty to disable.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# or: SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASS=
MAIL_FROM="Devegen <no-reply@devegenventures.com>"

# Storage: "local" or "r2"
STORAGE_DRIVER=local
UPLOAD_DIR=./src/uploads
# Public URL of this API, so locally stored uploads get absolute links
# (the frontend runs on other domains). Not needed with R2.
API_PUBLIC_URL=http://localhost:5000

# Cloudflare R2 (only when STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
