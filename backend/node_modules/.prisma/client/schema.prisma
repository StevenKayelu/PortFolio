// ============================================================
// Personal Brand Platform — Prisma Schema (MySQL)
// Conventions:
//  - Every table: id (cuid), createdAt, updatedAt
//  - Soft deletes via deletedAt (nullable) instead of hard delete
//  - AuditLog captures who changed what, generically, across tables
//  - snake_case @@map for DB tables, camelCase in Prisma client
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// AUTH / USERS
// ---------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(ADMIN)
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  refreshTokens RefreshToken[]
  blogPosts     BlogPost[]
  auditLogs     AuditLog[]
  projects      Project[]
  comments      Comment[]

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ipAddress String?

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // e.g. "CREATE", "UPDATE", "DELETE", "LOGIN"
  entityType String // e.g. "Project", "BlogPost"
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// ---------------------------------------------------------
// SITE / THEME / SEO SETTINGS (singleton-style config tables)
// ---------------------------------------------------------

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model ThemePreference {
  id         String   @id @default(cuid())
  name       String   @unique // e.g. "elegant-dark", "ocean-blue"
  label      String
  isDefault  Boolean  @default(false)
  isDarkMode Boolean  @default(true)
  tokens     Json // full token set: palette, typography, radii, shadows
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("theme_preferences")
}

model SeoMeta {
  id             String   @id @default(cuid())
  route          String   @unique // e.g. "/", "/blog/:slug" resolved path
  title          String
  description    String   @db.Text
  keywords       String?  @db.Text
  ogImage        String?
  canonicalUrl   String?
  structuredData Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("seo_meta")
}

// ---------------------------------------------------------
// SKILLS
// ---------------------------------------------------------

enum SkillCategory {
  FRONTEND
  BACKEND
  DATABASE
  CLOUD
  DEVOPS
  TOOLS
  LANGUAGE
  FRAMEWORK
  SOFT_SKILL
}

model Skill {
  id           String        @id @default(cuid())
  name         String
  category     SkillCategory
  proficiency  Int           @default(0) // 0-100
  icon         String?
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@index([category])
  @@map("skills")
}

// ---------------------------------------------------------
// PROJECTS / PORTFOLIO
// ---------------------------------------------------------

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

model ProjectCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  projects Project[]

  @@map("project_categories")
}

model Project {
  id                  String        @id @default(cuid())
  title               String
  slug                String        @unique
  summary             String        @db.Text
  description         String        @db.Text
  features            Json? // string[]
  challenges          String?       @db.Text
  solutions           String?       @db.Text
  lessonsLearned      String?       @db.Text
  architectureDiagram String?
  databaseDiagram     String?
  githubUrl           String?
  liveDemoUrl         String?
  videoDemoUrl        String?
  documentationUrl    String?
  coverImage          String?
  status              ProjectStatus @default(COMPLETED)
  isFeatured          Boolean       @default(false)
  displayOrder        Int           @default(0)
  viewCount           Int           @default(0)

  categoryId String?
  category   ProjectCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  images       ProjectImage[]
  technologies ProjectTechnology[]

  @@index([slug])
  @@index([categoryId])
  @@map("projects")
}

model ProjectImage {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url          String
  altText      String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([projectId])
  @@map("project_images")
}

model Technology {
  id   String  @id @default(cuid())
  name String  @unique
  icon String?

  projects ProjectTechnology[]

  @@map("technologies")
}

// explicit join table (features + metadata beyond simple m2m)
model ProjectTechnology {
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technologyId String
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
  @@map("project_technologies")
}

// ---------------------------------------------------------
// BLOG
// ---------------------------------------------------------

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model BlogCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  posts BlogPost[]

  @@map("blog_categories")
}

model BlogTag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  posts BlogPostTag[]

  @@map("blog_tags")
}

model BlogPost {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  excerpt         String     @db.Text
  content         String     @db.LongText // TipTap/EditorJS JSON or rendered HTML
  contentFormat   String     @default("tiptap-json")
  coverImage      String?
  status          PostStatus @default(DRAFT)
  isFeatured      Boolean    @default(false)
  isPinned        Boolean    @default(false)
  readingTimeMins Int        @default(1)
  viewCount       Int        @default(0)
  likeCount       Int        @default(0)

  seoTitle       String?
  seoDescription String? @db.Text
  ogImage        String?

  categoryId String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tags      BlogPostTag[]
  comments  Comment[]
  likes     BlogLike[]
  bookmarks BlogBookmark[]

  @@index([slug])
  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("blog_posts")
}

model BlogPostTag {
  postId String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId  String
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("blog_post_tags")
}

model Comment {
  id         String    @id @default(cuid())
  postId     String
  post       BlogPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestName  String?
  guestEmail String?
  content    String    @db.Text
  isApproved Boolean   @default(false)
  parentId   String?
  parent     Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies    Comment[] @relation("CommentReplies")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([postId])
  @@map("comments")
}

model BlogLike {
  id          String   @id @default(cuid())
  postId      String
  post        BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  fingerprint String // anonymous device/session fingerprint or userId
  createdAt   DateTime @default(now())

  @@unique([postId, fingerprint])
  @@map("blog_likes")
}

model BlogBookmark {
  id          String   @id @default(cuid())
  postId      String
  post        BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  fingerprint String
  createdAt   DateTime @default(now())

  @@unique([postId, fingerprint])
  @@map("blog_bookmarks")
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  isConfirmed    Boolean   @default(false)
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())

  @@map("newsletter_subscribers")
}

// ---------------------------------------------------------
// SERVICES
// ---------------------------------------------------------

model Service {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  description   String   @db.Text
  icon          String?
  startingPrice Decimal? @db.Decimal(10, 2)
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("services")
}

// ---------------------------------------------------------
// EXPERIENCE / TIMELINE
// ---------------------------------------------------------

enum ExperienceType {
  EMPLOYMENT
  INTERNSHIP
  FREELANCE
  LEADERSHIP
  VOLUNTEER
  INTERNET_CAFE
}

model Experience {
  id           String         @id @default(cuid())
  type         ExperienceType
  title        String
  organization String
  location     String?
  startDate    DateTime
  endDate      DateTime?
  isCurrent    Boolean        @default(false)
  description  String         @db.Text
  displayOrder Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  @@map("experiences")
}

// ---------------------------------------------------------
// CERTIFICATES
// ---------------------------------------------------------

model Certificate {
  id            String    @id @default(cuid())
  title         String
  institution   String
  category      String?
  issueDate     DateTime
  credentialId  String?
  credentialUrl String?
  imageUrl      String?
  fileUrl       String? // downloadable PDF
  displayOrder  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@map("certificates")
}

// ---------------------------------------------------------
// GALLERY
// ---------------------------------------------------------

model GalleryItem {
  id           String    @id @default(cuid())
  title        String?
  imageUrl     String
  category     String?
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@map("gallery_items")
}

// ---------------------------------------------------------
// TESTIMONIALS
// ---------------------------------------------------------

model Testimonial {
  id            String   @id @default(cuid())
  clientName    String
  clientRole    String?
  clientCompany String?
  clientAvatar  String?
  content       String   @db.Text
  rating        Int      @default(5)
  isFeatured    Boolean  @default(false)
  isApproved    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("testimonials")
}

// ---------------------------------------------------------
// ACHIEVEMENTS
// ---------------------------------------------------------

model Achievement {
  id           String   @id @default(cuid())
  title        String
  description  String   @db.Text
  date         DateTime
  icon         String?
  imageUrl     String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  @@map("achievements")
}

// ---------------------------------------------------------
// RESUME (structured, so it can render + generate PDF)
// ---------------------------------------------------------

model Resume {
  id        String   @id @default(cuid())
  isActive  Boolean  @default(true)
  fileUrl   String? // uploaded canonical PDF
  jsonData  Json? // structured fallback for rendering
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("resumes")
}

// ---------------------------------------------------------
// CONTACT / MESSAGES / FAQ
// ---------------------------------------------------------

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
  SPAM
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String        @db.Text
  status    MessageStatus @default(NEW)
  ipAddress String?
  createdAt DateTime      @default(now())
  deletedAt DateTime?

  @@index([status])
  @@map("contact_messages")
}

model Faq {
  id           String   @id @default(cuid())
  question     String
  answer       String   @db.Text
  category     String?
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("faqs")
}

// ---------------------------------------------------------
// ANALYTICS (lightweight, privacy-respecting)
// ---------------------------------------------------------

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  country   String?
  device    String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
  @@map("page_views")
}
