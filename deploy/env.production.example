# Copy to deploy/.env.production ON THE SERVER ONLY (chmod 600). Never commit it.

# PostgreSQL: MotoGo's server, Devegen's own database and login.
# Host is MotoGo's Postgres container, reached over motolink_internal.
# connection_limit keeps the pool small on a 1 GB server.
DATABASE_URL=postgresql://devegen:CHANGE_ME@motolink-postgres-1:5432/devegen?schema=public&connection_limit=5

# Both public sites (and www) may call the API.
CLIENT_URLS=https://stevenkayelu.online,https://www.stevenkayelu.online,https://devegenventures.com,https://www.devegenventures.com

# Long random values: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
LEAD_IP_SALT=CHANGE_ME

ADMIN_URL=https://stevenkayelu.online
# The admin (stevenkayelu.online) uses api.stevenkayelu.online: same site, so "lax" works.
COOKIE_SAMESITE=lax

# Files: Cloudflare R2 (public bucket for previews/images, private bucket for originals)
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_PRIVATE_BUCKET=

# Email (optional)
SMTP_URL=
MAIL_FROM="Devegen <no-reply@devegenventures.com>"
